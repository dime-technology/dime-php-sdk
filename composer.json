{
    "name": "dime-technology/dime-php-sdk",
    "description": "Official PHP SDK for the Dime Payments API.",
    "type": "library",
    "keywords": ["dime", "dime-payments", "payments", "sdk", "api-client"],
    "homepage": "https://github.com/dime-technology/dime-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Dime Payments Inc.",
            "homepage": "https://dimepayments.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "pestphp/pest": "^3.5",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DimePayments\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DimePayments\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
